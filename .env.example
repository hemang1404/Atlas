# Atlas Environment Configuration Template
# Copy this file to .env and customize values for your local environment:
# cp .env.example .env

PROJECT_NAME="Atlas API"
VERSION="0.1.0"
DEBUG=False

# Database Connection URL:
# SQLite (Local Development):
DATABASE_URL="sqlite:///./atlas.db"
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://atlas_user:password@localhost:5432/atlas_db"

# Security & Authentication:
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY="insecure-default-change-in-production-atlas-secret-key-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
